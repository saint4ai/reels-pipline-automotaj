#!/usr/bin/env python3
# ---------------------------------------------------------------------------
#  build.py — сборщик композиции
#  onAI Academy · @saint4ai · https://onai.academy
#  storyboard.json + transcript.json → index.html
#  Модель правит JSON на 8 КБ, а не HTML на 95 КБ.
#  origin=onai-rpa-2026-09  spec=three-laws/v1
# ---------------------------------------------------------------------------
from __future__ import annotations
import html
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SB = json.loads((ROOT / "storyboard.json").read_text(encoding="utf-8-sig"))
WORDS = json.loads((ROOT / "transcript.json").read_text(encoding="utf-8-sig"))

C = SB["composition"]
DUR = C["durationSeconds"]
PANEL = SB["spine"]["panel"]
LANE = SB["captions"]["lane"]
EMPH = set(SB["captions"]["emphasis"])
BOX = SB["layout"]["footageBox"]


# ---------------------------------------------------------------- субтитры
def group_words(words):
    """Группы по 2–4 слова, разрыв по паузе, точке и длине."""
    groups, cur = [], []
    for w in words:
        if w["start"] >= DUR:
            break
        if cur:
            gap = w["start"] - cur[-1]["end"]
            span = w["end"] - cur[0]["start"]
            if len(cur) >= 3 or gap > 0.34 or span > 1.35:
                groups.append(cur)
                cur = []
        cur.append(w)
        if len(cur) >= 2 and str(w["text"]).rstrip().endswith((".", "!", "?")):
            groups.append(cur)
            cur = []
    if cur:
        groups.append(cur)
    return groups


def caption_markup(groups):
    blocks, tl = [], []
    for i, g in enumerate(groups, 1):
        s, e = g[0]["start"], g[-1]["end"]
        label = " ".join(str(w["text"]) for w in g)
        spans = []
        for w in g:
            t = str(w["text"])
            cls = "cw cw--emph" if t.strip(",.!?") in {x.strip(",.!?") for x in EMPH} else "cw"
            spans.append(
                f'<span class="{cls}" data-ws="{w["start"]:.2f}" data-we="{w["end"]:.2f}">'
                f"{html.escape(t)}</span>"
            )
        blocks.append(
            f'      <div id="cap-{i:02d}" class="clip caption" data-start="{s:.2f}" '
            f'data-duration="{max(e - s, 0.2):.3f}" data-track-index="8" '
            f'aria-label="{html.escape(label, quote=True)}">'
            f'<div class="cap-card">{" ".join(spans)}</div></div>'
        )
        tl.append(
            f'    tl.fromTo("#cap-{i:02d} .cap-card",{{opacity:0,y:12}},'
            f'{{opacity:1,y:0,duration:.13,ease:"power3.out",immediateRender:false}},{s:.2f});'
        )
    return "\n".join(blocks), "\n".join(tl)


# ---------------------------------------------------------------- позвоночник
ICON = {
    "dm": "assets/icons/message-circle.svg",
    "comment": "assets/icons/message-square-text.svg",
    "publish": "assets/icons/send.svg",
    "bars": "assets/icons/chart-column.svg",
    "target": "assets/icons/target.svg",
    "cart": "assets/icons/shopping-cart.svg",
}


def spine_markup():
    sp = SB["spine"]
    tiles = sp["tiles"]
    lit = {e["tile"]: e["at"] for e in sp["flowing"]["litInPlace"]}
    n = len(tiles)
    gap, tw = 22, (960 - 2 * 44 - (n - 1) * 22) // n
    parts = [
        f'      <div id="panel" class="clip" data-start="0" data-duration="{DUR:.3f}" data-track-index="3">',
        '        <div class="panel-skin"></div>',
        '        <div id="chip-claude" class="chip">'
        '<img src="assets/brand/claude.svg" alt=""><span>CLAUDE</span></div>',
        '        <div id="socket"><i></i></div>',
        '        <div id="chip-ig" class="chip chip--r">'
        '<img src="assets/brand/instagram.svg" alt=""><span>INSTAGRAM</span></div>',
        '        <div id="wire"></div>',
        '        <div id="queue">',
    ]
    for i, t in enumerate(tiles):
        x = 44 + i * (tw + gap)
        state = "lit" if t["id"] in lit else "dark"
        parts.append(
            f'          <div id="{t["id"]}" class="tile" data-state="{state}" '
            f'style="left:{x}px;width:{tw}px">'
            f'<img class="tile-ico" src="{ICON[t["glyph"]]}" alt=""></div>'
        )
    parts += ["        </div>",
              '        <div id="rail"><div id="beam"></div></div>',
              '        <div id="budget"><i></i></div>', "      </div>"]

    tl = []
    for ch in sp["chips"]:
        tl.append(
            f'    tl.fromTo("#{ch["id"]}",{{opacity:0,scale:.82}},'
            f'{{opacity:1,scale:1,duration:.34,ease:"back.out(1.6)"}},{ch["at"]:.2f});'
        )
    tl.append(
        f'    tl.fromTo("#socket i",{{opacity:0}},{{opacity:1,duration:.3}},'
        f'{sp["socket"]["emptyFrom"]:.2f});'
    )
    for t in tiles:
        tl.append(
            f'    tl.fromTo("#{t["id"]}",{{opacity:0,x:150,y:-40}},'
            f'{{opacity:1,x:0,y:0,duration:.42,ease:"power3.out"}},{t["at"]:.2f});'
        )
        tl.append(
            f'    tl.set("#{t["id"]}",{{attr:{{"data-arrived":"1"}}}},{t["at"] + 0.42:.2f});'
        )
    tl.append(
        f'    tl.fromTo("#wire",{{scaleX:0}},{{scaleX:1,duration:.7,ease:"power2.inOut"}},'
        f'{sp["socket"]["wiredAt"]:.2f});'
    )
    tl.append(f'    tl.to("#socket i",{{opacity:0,duration:.3}},{sp["socket"]["closedAt"]:.2f});')
    cl = sp["climax"]["at"]
    tl.append(f'    tl.to("#panel .panel-skin",{{"--fill":1,duration:.5,ease:"power2.inOut"}},{cl:.2f});')
    tl.append(f'    tl.to("#panel",{{"--ink":1,duration:.5}},{cl:.2f});')
    tl.append(f'    tl.to("#panel .panel-skin",{{"--fill":0,duration:.6,ease:"power2.inOut"}},{cl + 1.2:.2f});')
    tl.append(f'    tl.to("#panel",{{"--ink":0,duration:.6}},{cl + 1.2:.2f});')
    tl.append(f'    tl.fromTo("#beam",{{opacity:0,x:0}},{{opacity:.9,x:820,duration:1.1,ease:"power2.inOut"}},{sp["socket"]["closedAt"]:.2f});')
    tl.append(f'    tl.to("#beam",{{opacity:0,duration:.3}},{sp["socket"]["closedAt"] + 1.1:.2f});')
    for tid, at in lit.items():
        tl.append(
            f'    tl.to("#{tid}",{{"--on":1,duration:.26,ease:"power2.out"}},{at:.2f});'
        )
    b = SB["budget"]
    tl.append(f'    tl.fromTo("#budget",{{opacity:0}},{{opacity:1,duration:.3}},{b["appearsAt"]:.2f});')
    tl.append(
        f'    tl.fromTo("#budget i",{{scaleX:1}},{{scaleX:{1 - b["spent"] / 20:.3f},'
        f'duration:{b["freezesAt"] - b["spendsFrom"]:.2f},ease:"none"}},{b["spendsFrom"]:.2f});'
    )
    tl.append('    tl.to("#panel",{height:250,duration:.5,ease:"power2.inOut"},19.10);')
    tl.append('    tl.to("#queue",{height:112,y:-108,duration:.5,ease:"power2.inOut"},19.10);')
    tl.append('    tl.to(".tile",{height:112,duration:.5,ease:"power2.inOut"},19.10);')
    tl.append('    tl.to(".tile-ico",{width:52,height:52,duration:.5},19.10);')
    tl.append('    tl.to("#panel",{height:560,duration:.6,ease:"power2.inOut"},33.90);')
    tl.append('    tl.to("#queue",{height:260,y:0,duration:.6,ease:"power2.inOut"},33.90);')
    tl.append('    tl.to(".tile",{height:260,duration:.6,ease:"power2.inOut"},33.90);')
    tl.append('    tl.to(".tile-ico",{width:92,height:92,duration:.6},33.90);')
    return "\n".join(parts), "\n".join(tl)


# ---------------------------------------------------------------- футажи
def media_markup():
    parts, tl = [], []
    for seg in SB["sources"]["footage"]["segments"]:
        d = seg["srcOut"] - seg["srcIn"]
        parts.append(
            f'      <video id="f{seg["id"]}" class="clip shot" data-start="{seg["at"]:.2f}" '
            f'data-duration="{d:.2f}" data-track-index="4" '
            f'src="media/f{seg["id"]}.mp4" muted playsinline preload="auto"></video>'
        )
    ch = SB["sources"]["chat"]
    parts.append(
        f'      <video id="chat" class="clip shot" data-start="{ch["at"]:.2f}" '
        f'data-duration="8.32" data-track-index="4" src="media/chat.mp4" '
        f'muted playsinline preload="auto"></video>'
    )
    # своя типографика поверх мягкого исходника — читаемость гарантируем сами
    parts.append(
        '      <div id="chat-cmd" class="clip overlay-line" data-start="28.16" '
        'data-duration="1.20" data-track-index="5">подключи мой Instagram</div>'
    )
    parts.append(
        '      <div id="chat-ok" class="clip overlay-chip" data-start="32.78" '
        'data-duration="0.76" data-track-index="5">@saint4ai · active</div>'
    )
    tl.append('    tl.fromTo("#chat-cmd",{opacity:0,y:14},{opacity:1,y:0,duration:.2},28.16);')
    tl.append('    tl.fromTo("#chat-ok",{opacity:0,scale:.86},{opacity:1,scale:1,duration:.24,ease:"back.out(1.7)"},32.78);')

    cta = SB["sources"]["cta"]
    parts.append(
        f'      <video id="cta" class="clip shot shot--cta" data-start="{cta["placeAt"]:.2f}" '
        f'data-duration="4.65" data-track-index="4" src="media/cta.mp4" '
        f'muted playsinline preload="auto"></video>'
    )
    return "\n".join(parts), "\n".join(tl)


def speaker_markup():
    st = SB["speakerWindow"]["states"]
    tl = []
    for m in SB["speakerWindow"]["moves"]:
        key = m["to"].split("-")[0] + "-" + m["to"].split("-")[1]
        s = st[key]
        x = s.get("x", s.get("xRight" if m["to"].endswith("right") else "xLeft", 180))
        tl.append(
            f'    tl.to("#spk",{{x:{x},y:{s["y"]},width:{s["w"]},height:{s["h"]},'
            f'duration:.5,ease:"power2.inOut"}},{m["at"]:.2f});'
        )
    return tl


# ---------------------------------------------------------------- сборка
def main() -> None:
    groups = group_words(WORDS)
    cap_html, cap_tl = caption_markup(groups)
    spine_html, spine_tl = spine_markup()
    media_html, media_tl = media_markup()
    spk_tl = speaker_markup()

    tpl = (ROOT / "index.template").read_text(encoding="utf-8")
    out = (
        tpl.replace("<!--SPINE-->", spine_html)
        .replace("<!--MEDIA-->", media_html)
        .replace("<!--CAPTIONS-->", cap_html)
        .replace("//TL_SPINE", spine_tl)
        .replace("//TL_MEDIA", media_tl)
        .replace("//TL_SPK", "\n".join(spk_tl))
        .replace("//TL_CAPS", cap_tl)
        .replace("{{DUR}}", f"{DUR:.6f}")
        .replace("{{ID}}", C["id"])
    )
    (ROOT / "index.html").write_text(out, encoding="utf-8")
    print(f"index.html собран: {len(out)} байт, {len(groups)} групп субтитров, "
          f"{len(SB['spine']['tiles'])} плиток, {len(SB['sources']['footage']['segments'])} сегментов футажа")


if __name__ == "__main__":
    main()
