<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>Reels 1 · Composio</title>
    <script src="assets/vendor/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Montserrat"; font-style: normal; font-weight: 700;
        src: url("assets/fonts/montserrat-cyrillic-700-normal.woff2") format("woff2");
        unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116; }
      @font-face { font-family: "Montserrat"; font-style: normal; font-weight: 700;
        src: url("assets/fonts/montserrat-latin-700-normal.woff2") format("woff2");
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+2122; }
      @font-face { font-family: "Montserrat"; font-style: normal; font-weight: 900;
        src: url("assets/fonts/montserrat-cyrillic-900-normal.woff2") format("woff2");
        unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116; }
      @font-face { font-family: "Montserrat"; font-style: normal; font-weight: 900;
        src: url("assets/fonts/montserrat-latin-900-normal.woff2") format("woff2");
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+2122; }
      @font-face { font-family: "STIX Two Text"; font-style: italic; font-weight: 700;
        src: url("assets/fonts/stix-two-text-cyrillic-700-italic.woff2") format("woff2");
        unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116; }
      @font-face { font-family: "STIX Two Text"; font-style: italic; font-weight: 700;
        src: url("assets/fonts/stix-two-text-latin-700-italic.woff2") format("woff2");
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+2000-206F,U+2122; }

      /* токены: minimal (белый лист) + whiteboard (оранжевый маркер) */
      :root {
        --paper: #FFFFFF;
        --ink: #0E0E10;
        --muted: #6B7280;
        --accent: #FF6B35;
        --grid: rgba(14,14,16,.038);
        --glow: linear-gradient(155deg, #CFE2F5 0%, #8FBCEA 55%, #6FA8E0 100%);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; margin: 0; overflow: hidden; background: var(--paper); }
      body { font-family: "Montserrat", Arial, sans-serif; color: var(--ink); }
      #root { position: relative; width: 1080px; height: 1920px; overflow: hidden;
              background: var(--paper); isolation: isolate; }

      #grid { position: absolute; inset: 0;
              background-image: linear-gradient(var(--grid) 1px, transparent 1px),
                                linear-gradient(90deg, var(--grid) 1px, transparent 1px);
              background-size: 96px 96px; }

      /* ---------- экраны: скруглённая карточка на синем свечении ---------- */
      .glow { position: absolute; left: 46px; top: 372px; width: 988px; height: 566px;
              background: var(--glow); border-radius: 40px; filter: blur(2px); opacity: 0; }
      .shot { position: absolute; left: 70px; top: 396px; width: 940px; height: 518px;
              object-fit: cover; border-radius: 28px; background: #fff;
              box-shadow: 0 26px 60px -22px rgba(14,14,16,.42); }
      .shot--cta { left: 250px; top: 300px; width: 580px; height: 700px; object-fit: contain; }

      /* ---------- спикер: скруглённый портрет внизу слева ---------- */
      #spk { position: absolute; left: 74px; top: 1198px; width: 396px; height: 528px;
             overflow: hidden; border-radius: 22px;
             box-shadow: 0 24px 60px -20px rgba(14,14,16,.45),
                         0 0 0 4px rgba(255,255,255,.7), 0 0 0 5px rgba(14,14,16,.10); }
      #spk video { width: 100%; height: 100%; object-fit: cover; }

      /* ---------- брендовый астериск ---------- */
      #mark { position: absolute; right: 44px; top: 1120px; width: 190px; height: 190px;
              opacity: 0; filter: drop-shadow(0 14px 26px rgba(255,107,53,.34)); }
      #mark path { fill: var(--accent); }

      /* ---------- кинетический текст: три регистра ---------- */
      .caption { position: absolute; left: 70px; width: 940px; top: 980px;
                 display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px; }
      .caption[data-align="right"] { justify-content: flex-end; text-align: right; }
      .caption[data-align="left"] { justify-content: flex-start; }
      .cw { display: inline-block; font-weight: 500; font-size: 52px; line-height: 1.04;
            letter-spacing: -.02em; color: var(--muted); }
      .cw--key { font-weight: 900; font-size: 76px; line-height: .98; letter-spacing: -.035em;
                 text-transform: uppercase; color: var(--ink); }
      .caption.big .cw { font-size: 68px; }
      .caption.big .cw--key { font-size: 104px; }
      .caption.big .cw--emph { font-size: 106px; }
      .cw--emph { font-family: "STIX Two Text", Georgia, serif; font-style: italic;
                  font-weight: 700; font-size: 78px; line-height: .96; letter-spacing: -.03em;
                  color: var(--accent); text-transform: none; }

      /* ---------- финальный режим: спикер на весь кадр ---------- */
      #spk.full { left: 0; top: 0; width: 1080px; height: 1920px; border-radius: 0;
                  box-shadow: none; }
      .caption.over { color: #fff; }
      .caption.over .cw { color: rgba(255,255,255,.82); }
      .caption.over .cw--key { color: #fff; text-shadow: 0 6px 30px rgba(0,0,0,.55); }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="{{ID}}" data-start="0" data-duration="{{DUR}}"
         data-width="1080" data-height="1920" data-fps="30">

      <div id="paper" class="clip" data-start="0" data-duration="{{DUR}}" data-track-index="0">
        <div id="grid"></div>
      </div>

<!--MEDIA-->

      <div id="spk">
        <video id="spk-video" class="clip" data-start="0" data-duration="{{DUR}}"
               data-track-index="6" src="media/speaker.mp4" muted playsinline preload="auto"></video>
      </div>

      <svg id="mark" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 2l6 30 22-20-14 27 30-6-28 14 28 14-30-6 14 27-22-20-6 30-6-30-22 20 14-27-30 6 28-14-28-14 30 6-14-27 22 20z"/></svg>

<!--CAPTIONS-->

      <audio id="speech" class="clip" data-start="0" data-duration="{{DUR}}"
             data-track-index="10" data-volume="1" src="media/speech.m4a" preload="auto"></audio>
    </div>

    <script>
      (function () {
        "use strict";
        var DUR = {{DUR}};
        var tl = gsap.timeline({ paused: true });

//TL_MEDIA

//TL_MARK

//TL_CAPS

        tl.seek(0);
        window.__timelines = window.__timelines || {};
        window.__timelines["{{ID}}"] = tl;
      })();
    </script>
  </body>
</html>
