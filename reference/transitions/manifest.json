  "provenance": {
    "receivedFrom": "user-provided local media folder",
    "originalLocalFolder": "<user-downloads>/аудио",
    "licenseStatus": "unverified-user-supplied",
    "warning": "The files contain creator handles and/or baked watermarks. Do not redistribute, remove attribution, publish, or use commercially until the user confirms the relevant rights or supplies clean licensed masters."
  },
  "globalRules": {
    "alpha": {
      "allSourcesHaveAlpha": false,
      "blackBackgroundSources": "Use Screen or Lighten only on an exact approved burst. Opacity alone does not remove black."
    },
    "opacity": {
      "normalRange": [
        0.6,
        0.7
      ],
      "absoluteMaximum": 0.7,
      "fullWhiteFlashRange": [
        0.45,
        0.5
      ],
      "rule": "Choose the per-window range below. White flashes never use the library-wide 70 percent ceiling."
    },
    "rhythm": {
      "minimumSecondsBetweenStockTransitions": 6,
      "preferredSecondsBetweenStockTransitions": [
        6,
        10
      ],
      "maximumFilmBurnsPer60Seconds": 3,
      "maximumPureWhiteFlashesPerReel": 1,
      "rule": "A stock transition must mark a real semantic, chapter, layout, or scene change. Never place one on every cut or choose one randomly without a narrative reason."
    },
    "audio": {
      "defaultPolicy": "mute-embedded-audio",
      "transitionSfxTargetPeakDbfs": [
        -18,
        -12
      ],
      "maximumNarrationDuckDb": 1.5,
      "rule": "Narration remains dominant. Embedded tracks are reference audio only; isolate and level a useful transient or use a separately licensed SFX."
    },
    "qa": [
      "Preview the exact trimmed burst at 1080x1920 before render.",
      "Reject any frame that reveals a watermark, promo text, CTA, profile card, or unrelated baked graphic.",
      "Check the transition under both Instagram Reels and TikTok UI overlays.",
      "Do not cover the speaker's eyes, active subtitle band, hook, CTA, or key diagram labels.",
      "Use the source SHA-256 to detect silent binary replacement."
    ]
  },
